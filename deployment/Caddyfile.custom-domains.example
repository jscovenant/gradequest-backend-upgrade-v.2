{
    on_demand_tls {
        ask http://127.0.0.1:8000/api/internal/domains/tls-allowed?token={$CUSTOM_DOMAIN_TLS_ASK_SECRET}
        interval 2m
        burst 5
    }
}

https:// {
    tls {
        on_demand
    }

    handle /api/* {
        reverse_proxy 127.0.0.1:8000
    }

    handle {
        root * /var/www/gradequest/frontend/dist
        try_files {path} /index.html
        file_server
    }
}
